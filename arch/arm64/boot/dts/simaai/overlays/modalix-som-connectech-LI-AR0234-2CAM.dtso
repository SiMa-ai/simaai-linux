/dts-v1/;
/plugin/;

#include "modalix-som-connectech-2CAM.dtsi"

&{/} {
    ar0234_vana_2: csi2_fixedregulator@0 {
        compatible = "regulator-fixed";
        regulator-name = "ar0234_vana_2";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
        enable-active-high;
        startup-delay-us = <300000>;
        regulator-always-on;
    };

    ar0234_vdig_2: csi2_fixedregulator@1 {
        compatible = "regulator-fixed";
        regulator-name = "ar0234_vdig_2";
        regulator-min-microvolt = <1050000>;
        regulator-max-microvolt = <1050000>;
        regulator-always-on;
    };

    ar0234_vddl_2: csi2_fixedregulator@2 {
        compatible = "regulator-fixed";
        regulator-name = "ar0234_vddl_2";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
    };

    ar0234_clk_2: csi2_camera-clk {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <27000000>;
    };
};

&csi20in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <270000000>;
    remote-endpoint = <&cam20out>;
    clock-continuous;
};

&i2c2 {
        ar0234s2: ar0234@10 {
                compatible = "onsemi,ar0234";
                reg = <0x10>;

                clocks = <&ar0234_clk_2>;
                clock-names = "xclk";

                VANA-supply = <&ar0234_vana_2>;
                VDIG-supply = <&ar0234_vdig_2>;
                VDDL-supply = <&ar0234_vddl_2>;

                port@1 {
                        cam20out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                link-frequencies = /bits/ 64 <270000000>;
                                remote-endpoint = <&csi20in>;
                                clock-continuous;
                        };
                };
        };
};
