/*
 * Copyright (c) 2026 SiMa ai
 *
 * li-imx568 (direct Sony imx568, sony,imx568) on modalix DVT csi0,
 * four-lane CSI-2 controller mode, i2c addr 0x3d, RAW12.
 */

/dts-v1/;
/plugin/;

&{/} {
	li_imx568_avdd_0: csi0-fixedregulator-0 {
		compatible = "regulator-fixed";
		regulator-name = "li_imx568_avdd_0";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		startup-delay-us = <300000>;
		regulator-always-on;
	};
	li_imx568_dvdd_0: csi0-fixedregulator-1 {
		compatible = "regulator-fixed";
		regulator-name = "li_imx568_dvdd_0";
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		regulator-always-on;
	};
	li_imx568_dovdd_0: csi0-fixedregulator-2 {
		compatible = "regulator-fixed";
		regulator-name = "li_imx568_dovdd_0";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
	li_imx568_clk_0: csi0-camera-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <37125000>;
	};
};

/* bt-* fallback for 1920x1080 RAW12 only; live timing comes from the sensor controls.
 * The sensor drives a continuous clock, so clock-noncontinuous is omitted. */
&csi0 {
	status = "okay";
	simaai,bt-pixelclock = /bits/ 64 <500000000>;
	simaai,bt-hsync = <2>;
	simaai,bt-hbackporch = <100>;
	simaai,bt-hfrontporch = <856>;
	simaai,bt-vsync = <1>;
	simaai,bt-vbackporch = <68>;
	simaai,bt-vfrontporch = <1>;
	simaai,ipi-controller-mode = <1>;
	simaai,ipi-controller-enable-delay-ms = <800>;
	simaai,ipi-emb-data-enable = <0>;
};

&axi_vdma0 {
	status = "okay";
};

&mipi_dphy_rx0 {
	status = "okay";
};

&v4l2video0 {
	status = "okay";
};

&v4l2vdma0 {
	status = "okay";
};

&csi00in {
	clock-lanes = <0>;
	data-lanes = <1 2 3 4>;
	link-frequencies = /bits/ 64 <594000000>;
	remote-endpoint = <&cam00out>;
};

&i2c00 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	li_imx568_0: camera@3d {
		compatible = "sony,imx568";
		reg = <0x3d>;

		clocks = <&li_imx568_clk_0>;
		clock-names = "inck";

		avdd-supply = <&li_imx568_avdd_0>;
		dvdd-supply = <&li_imx568_dvdd_0>;
		dovdd-supply = <&li_imx568_dovdd_0>;

		port {
			cam00out: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <594000000>;
				remote-endpoint = <&csi00in>;
			};
		};
	};
};
