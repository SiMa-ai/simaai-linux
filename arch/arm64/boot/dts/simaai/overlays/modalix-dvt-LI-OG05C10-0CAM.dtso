/dts-v1/;
/plugin/;

&{/} {
    og05c10_vana_0: csi0_fixedregulator@0 {
        compatible = "regulator-fixed";
        regulator-name = "og05c10_vana_0";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
        enable-active-high;
        startup-delay-us = <300000>;
        regulator-always-on;
    };
    og05c10_vdig_0: csi0_fixedregulator@1 {
        compatible = "regulator-fixed";
        regulator-name = "og05c10_vdig_0";
        regulator-min-microvolt = <1050000>;
        regulator-max-microvolt = <1050000>;
        regulator-always-on;
    };
    og05c10_vddl_0: csi0_fixedregulator@2 {
        compatible = "regulator-fixed";
        regulator-name = "og05c10_vddl_0";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
    };
    og05c10_clk_0: csi0_camera-clk {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <24000000>;
    };
};

&csi0 {
    status = "okay";
};

&axi_vdma0 {
    status = "okay";
};

&mipi_dphy_rx0 {
    status = "okay";
};

&v4l2video0 {
    status = "okay";
};

&v4l2vdma0 {
    status = "okay";
};

&csi00in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <424000000>;
    remote-endpoint = <&cam00out>;
    clock-continuous;
};

&i2c00 {
    status = "okay";
    clock-frequency = <400000>;
    #address-cells = <1>;
    #size-cells = <0>;

    og05c10: og05c10@36 {
        compatible = "OV,og05c10";
        reg = <0x36>;

        clocks = <&og05c10_clk_0>;
        clock-names = "xclk";

        VANA-supply = <&og05c10_vana_0>;
        VDIG-supply = <&og05c10_vdig_0>;
        VDDL-supply = <&og05c10_vddl_0>;

        port@1 {
            cam00out: endpoint@0 {
                clock-lanes = <0>;
                data-lanes = <1 2>;
                link-frequencies = /bits/ 64 <424000000>;
                remote-endpoint = <&csi00in>;
                clock-continuous;
            };
        };
    };
};
