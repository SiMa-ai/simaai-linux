/dts-v1/;
/plugin/;

&{/} {
    imx568_vana_2: csi2_fixedregulator@0 {
        compatible = "regulator-fixed";
        regulator-name = "imx568_vana_2";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        enable-active-high;
        startup-delay-us = <300000>;
        regulator-always-on;
    };

    imx568_vdig_2: csi2_fixedregulator@1 {
        compatible = "regulator-fixed";
        regulator-name = "imx568_vdig_2";
        regulator-min-microvolt = <110000>;
        regulator-max-microvolt = <110000>;
        regulator-always-on;
    };

    imx568_vddl_2: csi2_fixedregulator@2 {
        compatible = "regulator-fixed";
        regulator-name = "imx568_vddl_2";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
    };

    imx568_clk_2: csi2_camera-clk {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <37125000>;
    };

    i2cmux0: i2cmux@0 {
        compatible = "i2c-mux-gpio";
        i2c-parent = <&i2c52>;
        #address-cells = <1>;
        #size-cells = <0>;
        /* Set port6 gpio6 to GPIO_ACTIVE_LOW mode */
        mux-gpios = <&port6 6 0>;

        i2cmux0p1: i2c@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;
        };
    };
};

&port5 {
        cam-hog1 {
                gpio-hog;
                /* Set port5 gpio7 to GPIO_ACTIVE_HIGH mode */
                gpios = <7 0>;
                output-high;
                line-name = "cam1_powdn";
        };
};

&i2c52 {
    status = "okay";
    clock-frequency = <400000>;
    #address-cells = <1>;
    #size-cells = <0>;
};

&csi2 {
    status = "okay";

    /* controller mode: IPI generates frame timing from these bt blanking values (active res from set_fmt) */
    simaai,bt-pixelclock = /bits/ 64 <500000000>;
    simaai,bt-hsync = <2>;
    simaai,bt-hbackporch = <100>;
    simaai,bt-hfrontporch = <1548>;
    simaai,bt-vsync = <1>;
    simaai,bt-vbackporch = <68>;
    simaai,bt-vfrontporch = <1>;
    simaai,ipi-controller-mode = <1>;
    simaai,ipi-emb-data-enable = <0>;
};

&axi_vdma2 {
    status = "okay";
};

&mipi_dphy_rx2 {
    status = "okay";
};

&v4l2video2 {
    status = "okay";
};

&v4l2vdma2 {
    status = "okay";
};

&csi20in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <594000000>;
    remote-endpoint = <&cam20out>;
    clock-continuous;
};

&i2cmux0p1 {
    pca6408_camera_p1: pca6408@20 {
        compatible = "ti,tca6408";
        gpio-controller;
        #gpio-cells = <2>;
        reg = <0x20>;
        status = "okay";
    };

    pca6408_fpga_p1: pca6408@21 {
        compatible = "ti,tca6408";
        gpio-controller;
        #gpio-cells = <2>;
        reg = <0x21>;
        status = "okay";
    };

    fpga_p1: fpga@c {
        compatible = "econ,fpga";
        reg = <0x0c>;
        status = "okay";
        fpga_nprogram-gpios = <&pca6408_fpga_p1 2 0>;
        fpga_nreset-gpios = <&pca6408_fpga_p1 3 0>;
        fpga_slaveid_sel0-gpios = <&pca6408_fpga_p1 4 0>;
        fpga_slaveid_sel1-gpios = <&pca6408_fpga_p1 7 0>;
		mipi_filter_dt1 = <0x92>;
		mipi_filter_dt2 = <0x93>;
		mipi_filter_dt3 = <0xb7>;
		mipi_filter_dt4 = <0x7f>;
		mipi_speed = <1188>;
		mipi_tx_clockmode = <0>; // Discontinuous
		mipi_rx_clockmode = <0>; // Discontinuous
    };

    imx568p1: imx568@42 {
        compatible = "econ,imx568";
        reg = <0x42>;
        clocks = <&imx568_clk_2>;
        clock-names = "xclk";
        VANA-supply = <&imx568_vana_2>;
        VDIG-supply = <&imx568_vdig_2>;
        VDDL-supply = <&imx568_vddl_2>;
        reset-gpios = <&pca6408_camera_p1 1 0>;
        boot-gpios  = <&pca6408_camera_p1 0 0>;

        /* Exposure window limits in microseconds (min 300 us, max 18 ms) */
        simaai,manual_exposure_min = <300>;
        simaai,manual_exposure_max = <18000>;
        camera_mipi_lanes = <2>;
        cam_fw_name = "imx568_cam_fw.bin";

        port@1 {
            cam20out: endpoint@0 {
                clock-lanes = <0>;
                data-lanes = <1 2>;
                link-frequencies = /bits/ 64 <594000000>;
                remote-endpoint = <&csi20in>;
                clock-continuous;
            };
        };
    };
};
