/dts-v1/;
/plugin/;

&{/} {
    og05c10_vana_sh: csi_fixedregulator@0 {
        compatible = "regulator-fixed";
        regulator-name = "og05c10_vana_sh";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
        enable-active-high;
        startup-delay-us = <300000>;
        regulator-always-on;
    };

    og05c10_vdig_sh: csi_fixedregulator@1 {
        compatible = "regulator-fixed";
        regulator-name = "og05c10_vdig_sh";
        regulator-min-microvolt = <1050000>;
        regulator-max-microvolt = <1050000>;
        regulator-always-on;
    };

    og05c10_vddl_sh: csi_fixedregulator@2 {
        compatible = "regulator-fixed";
        regulator-name = "og05c10_vddl_sh";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
    };

    og05c10_clk_sh: csi_camera-clk {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <24000000>;
    };

    i2cmux0: i2cmux@0 {
        compatible = "i2c-mux-gpio";
        i2c-parent = <&i2c52>;
        #address-cells = <1>;
        #size-cells = <0>;
        /* Set port6 gpio6 to GPIO_ACTIVE_LOW mode */
        mux-gpios = <&port6 6 0>;

        i2cmux0p0: i2c@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;
        };

        i2cmux0p1: i2c@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;
        };
    };
};

&port5 {
    cam-hog0 {
        gpio-hog;
        /* Set port5 gpio6 to GPIO_ACTIVE_HIGH mode */
        gpios = <6 0>;
        output-high;
        line-name = "cam0_powdn";
    };

    cam-hog1 {
        gpio-hog;
        /* Set port5 gpio7 to GPIO_ACTIVE_HIGH mode */
        gpios = <7 0>;
        output-high;
        line-name = "cam1_powdn";
    };
};

&i2c52 {
    status = "okay";
    clock-frequency = <400000>;
    #address-cells = <1>;
    #size-cells = <0>;
};

&csi1 {
    status = "okay";
};

&csi2 {
    status = "okay";
};

&axi_vdma1 {
    status = "okay";
};

&axi_vdma2 {
    status = "okay";
};

&mipi_dphy_rx1 {
    status = "okay";
};

&mipi_dphy_rx2 {
    status = "okay";
};

&v4l2video1 {
    status = "okay";
};

&v4l2video2 {
    status = "okay";
};

&v4l2vdma1 {
    status = "okay";
};

&v4l2vdma2 {
    status = "okay";
};

&csi10in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <424000000>;
    remote-endpoint = <&cam10out>;
    clock-continuous;
};

&csi20in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <424000000>;
    remote-endpoint = <&cam20out>;
    clock-continuous;
};

&i2cmux0p0 {
    og05c10p0: og05c10@36 {
        compatible = "OV,og05c10";
        reg = <0x36>;

        clocks = <&og05c10_clk_sh>;
        clock-names = "xclk";

        VANA-supply = <&og05c10_vana_sh>;
        VDIG-supply = <&og05c10_vdig_sh>;
        VDDL-supply = <&og05c10_vddl_sh>;

        port@1 {
            cam10out: endpoint@0 {
                clock-lanes = <0>;
                data-lanes = <1 2>;
                link-frequencies = /bits/ 64 <424000000>;
                remote-endpoint = <&csi10in>;
                clock-continuous;
            };
        };
    };
};

&i2cmux0p1 {
    og05c10p1: og05c10@36 {
        compatible = "OV,og05c10";
        reg = <0x36>;

        clocks = <&og05c10_clk_sh>;
        clock-names = "xclk";

        VANA-supply = <&og05c10_vana_sh>;
        VDIG-supply = <&og05c10_vdig_sh>;
        VDDL-supply = <&og05c10_vddl_sh>;

        port@1 {
            cam20out: endpoint@0 {
                clock-lanes = <0>;
                data-lanes = <1 2>;
                link-frequencies = /bits/ 64 <424000000>;
                remote-endpoint = <&csi20in>;
                clock-continuous;
            };
        };
    };
};
