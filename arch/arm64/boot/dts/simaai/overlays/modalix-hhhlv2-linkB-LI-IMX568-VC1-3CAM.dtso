/dts-v1/;
/plugin/;

&{/} {
	max_des_0_ser_1_cam_0_xclk: max_des_0_ser_1_cam_0_xclk {
		status = "okay";
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* Sensor INCK, not the serializer reference clock. */
		clock-frequency = <37125000>;
	};
};

&i2c01 {
	max_des_0: gmsl-deserializer@28 {
		#address-cells = <1>;
		#size-cells = <0>;

		compatible = "maxim,max96716a";
		reg = <0x28>;
	};
};

&max_des_0 {
	i2c-alias-pool = <0x44 0x45 0x46 0x47>;
	max_des_0_i2c_adapter: i2c-atr {
		#address-cells = <1>;
		#size-cells = <0>;
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&max_des_0 {
	ports {
		port@3 {
			reg = <3>;
			max_des_0_phy_out_1: endpoint@1 {
				reg = <1>;
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <700000000>;
				clock-continuous;
			};
		};
	};
};

&csi3 {
	status = "okay";
};

&csi31in{
	clock-lanes = <0>;
	data-lanes = <1 2 3 4>;
	link-frequencies = /bits/ 64 <700000000>;
	remote-endpoint = <&max_des_0_phy_out_1>;
	clock-continuous;
};

&max_des_0_phy_out_1 {
	remote-endpoint = <&csi31in>;
};

&max_des_0_i2c_adapter {
	max_des_0_i2c_1: i2c@1 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x1>;
	};
};

&max_des_0_i2c_1 {
	max_des_0_ser_1: gmsl-serializer@62 {
		#address-cells = <1>;
		#size-cells = <0>;
		#gpio-cells = <2>;

		compatible = "maxim,max9295a";
		reg = <0x62>;

		gpio-controller;
		gpio-ranges = <&max_des_0_ser_1 0 0 11>;
	};
};

&max_des_0_ser_1 {
	i2c-alias-pool = <0x4a 0x4b>;
	i2c-atr {
		#address-cells = <1>;
		#size-cells = <0>;

		max_des_0_ser_1_i2c_0: i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0>;
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			max_des_0_ser_1_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&max_des_0_in_1>;
			};
		};
	};
};

&max_des_0 {
	ports {
		port@1 {
			reg = <1>;
			max_des_0_in_1: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&max_des_0_ser_1_out>;
			};
		};
	};
};

&max_des_0_ser_1_i2c_0 {
	max_des_0_ser_1_cam_0: camera@3d {
		compatible = "sony,imx568";
		reg = <0x3d>;

		reset-gpios = <&max_des_0_ser_1 0 1>;

		clocks = <&max_des_0_ser_1_cam_0_xclk>;
		clock-names = "inck";

		avdd-supply = <&max_des_0_ser_1_cam_0_reg>;
		dvdd-supply = <&cam_dummy_reg>;
		dovdd-supply = <&cam_dummy_reg>;

		rotation = <0>;
		orientation = <2>;

		port {
			max_des_0_ser_1_cam_0_out: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <297000000>;
				remote-endpoint = <&max_des_0_ser_1_in_0>;
				clock-continuous;
			};
		};
	};
};

&max_des_0_ser_1 {
	ports {
		port@0 {
			reg = <0>;
			max_des_0_ser_1_in_0: endpoint@0 {
				reg = <0>;
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <297000000>;
				remote-endpoint = <&max_des_0_ser_1_cam_0_out>;
				clock-continuous;
			};
		};
	};
};

&axi_vdma3 {
	status = "okay";
};

&mipi_dphy_rx3 {
	status = "okay";
};

&v4l2video3 {
	status = "okay";
};

&v4l2vdma3 {
	status = "okay";
};

&raw31in {
	status = "okay";
};

/* imx568-only analog supply; kept last so the shared nodes stay line-aligned. */
&{/} {
	max_des_0_ser_1_cam_0_reg: max_des_0_ser_1_cam_0_reg {
		status = "okay";
		enable-active-high;
		regulator-name = "max_des_0_ser_1_cam_0_reg";
		startup-delay-us = <20000>;
		compatible = "regulator-fixed";
	};
};
