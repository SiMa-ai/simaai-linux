/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include "modalix-som-connectech-common.dtsi"

&{/} {
        xclk_shared: xclk {
                status = "okay";
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency = <24000000>;
        };
};

&port5 {
        gpio-line-names =
                     "",        /* pin 0 */
                     "",        /* pin 1 */
                     "",        /* pin 2 */
                     "",        /* pin 3 */
                     "",        /* pin 4 */
                     "",        /* pin 5 */
                     "SIMOR_RESET";        /* pin 6 */

        cam-hog1 {
                gpio-hog;
                /* Set port5 gpio7 to GPIO_ACTIVE_HIGH mode */
                gpios = <7 0>;
                output-high;
                line-name = "EEPROM_WP";
        };
};

&csi0 {
    status = "okay";
};

&csi1 {
    status = "okay";
};

&axi_vdma0 {
    status = "okay";
};

&axi_vdma1 {
    status = "okay";
};

&mipi_dphy_rx0 {
    status = "okay";
};

&mipi_dphy_rx1 {
    status = "okay";
    /* the band's own gain mode loses ~20% of this transmitter's frames;
     * mode 3, the choice above 1.5 Gbps, recovers them */
    snps,rx-hs-gain-mode = <3>;
};

&v4l2video0 {
    status = "okay";
};

&v4l2video1 {
    status = "okay";
};

&v4l2vdma0 {
    status = "okay";
};

&v4l2vdma1 {
    status = "okay";
};

&csi00in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <480000000>;
    remote-endpoint = <&cam00out>;
    clock-continuous;
};

&csi10in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <480000000>;
    remote-endpoint = <&cam10out>;
    clock-continuous;
};

&i2c0 {
        xc9080: xc9080@1b {
                compatible = "Metoak,xc9080";
                reg = <0x1b>;

                startup-delay-ms = <0>;
                reset-gpios = <&port5 6 GPIO_ACTIVE_LOW>;

                port@1 {
                        cam00out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                /* datasheet mipiclk 960 Mbps/lane (measured ~904) */
                                link-frequencies = /bits/ 64 <480000000>;
                                remote-endpoint = <&csi00in>;
                                clock-continuous;
                        };
                };
        };

        simor: simor@66 {
                compatible = "Metoak,simor";
                reg = <0x66>;

                port@1 {
                        cam10out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                /* datasheet mipiclk 960 Mbps/lane; with HS gain
                                 * mode 3 the 900, 1000 and 1100 bands receive
                                 * alike */
                                link-frequencies = /bits/ 64 <480000000>;
                                remote-endpoint = <&csi10in>;
                                clock-continuous;
                        };
                };
        };
};
