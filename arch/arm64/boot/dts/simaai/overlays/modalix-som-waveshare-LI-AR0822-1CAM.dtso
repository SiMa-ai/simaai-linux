/dts-v1/;
/plugin/;

&{/} {
    ar0822_vana_1: csi1_fixedregulator@0 {
        compatible = "regulator-fixed";
        regulator-name = "ar0822_vana_1";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
        enable-active-high;
        startup-delay-us = <300000>;
        regulator-always-on;
    };
    ar0822_vdig_1: csi1_fixedregulator@1 {
        compatible = "regulator-fixed";
        regulator-name = "ar0822_vdig_1";
        regulator-min-microvolt = <1050000>;
        regulator-max-microvolt = <1050000>;
        regulator-always-on;
    };
    ar0822_vddl_1: csi1_fixedregulator@2 {
        compatible = "regulator-fixed";
        regulator-name = "ar0822_vddl_1";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
    };
    ar0822_clk_1: csi1_camera-clk {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <27000000>;
    };

    i2cmux0: i2cmux@0 {
        compatible = "i2c-mux-gpio";
        i2c-parent = <&i2c52>;
        #address-cells = <1>;
        #size-cells = <0>;
	i2c-mux-idle-disconnect;
        /* Set port6 gpio6 to GPIO_ACTIVE_LOW mode */
        mux-gpios = <&port6 6 0>;

        i2cmux0p0: i2c@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;
        };
    };
};

&port5 {
    cam-hog0 {
        gpio-hog;
        /* Set port5 gpio6 to GPIO_ACTIVE_LOW mode */
        gpios = <6 1>;
        output-low;
        line-name = "cam0_powdn";
    };
};

&i2c52 {
    status = "okay";
    clock-frequency = <400000>;
    #address-cells = <1>;
    #size-cells = <0>;
};

&csi1 {
    status = "okay";
};

&axi_vdma1 {
    status = "okay";
};

&mipi_dphy_rx1 {
    status = "okay";
};

&v4l2video1 {
    status = "okay";
};

&v4l2vdma1 {
    status = "okay";
};

&csi10in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <492750000>;
    remote-endpoint = <&cam10out>;
    clock-continuous;
};

&i2cmux0p0 {
        ar0822p0: ar0822@10 {
                compatible = "onsemi,ar0822";
                reg = <0x10>;

                clocks = <&ar0822_clk_1>;
                clock-names = "xclk";

                rotation = <0>;
                orientation = <2>;


                VANA-supply = <&ar0822_vana_1>;
                VDIG-supply = <&ar0822_vdig_1>;
                VDDL-supply = <&ar0822_vddl_1>;

                port@1 {
                        cam10out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                link-frequencies = /bits/ 64 <492750000>;
                                remote-endpoint = <&csi10in>;
                                clock-continuous;
                        };
                };
        };
};
