/dts-v1/;
/plugin/;

&{/} {
    og05c10_vana_2: csi0_fixedregulator@0 {
        compatible = "regulator-fixed";
        regulator-name = "og05c10_vana_2";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
        enable-active-high;
        startup-delay-us = <300000>;
        regulator-always-on;
    };

    og05c10_vdig_2: csi0_fixedregulator@1 {
        compatible = "regulator-fixed";
        regulator-name = "og05c10_vdig_2";
        regulator-min-microvolt = <1050000>;
        regulator-max-microvolt = <1050000>;
        regulator-always-on;
    };

    og05c10_vddl_2: csi0_fixedregulator@2 {
        compatible = "regulator-fixed";
        regulator-name = "og05c10_vddl_2";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
    };

    og05c10_clk_2: csi0_camera-clk {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <24000000>;
    };

    i2cmux0: i2cmux@0 {
        compatible = "i2c-mux-gpio";
        i2c-parent = <&i2c52>;
        #address-cells = <1>;
        #size-cells = <0>;
        /* Set port6 gpio6 to GPIO_ACTIVE_LOW mode */
        mux-gpios = <&port6 6 0>;

        i2cmux0p0: i2c@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;
        };
    };
};

&port5 {
        cam-hog0 {
                gpio-hog;
                /* Set port5 gpio6 to GPIO_ACTIVE_HIGH mode */
                gpios = <6 0>;
                output-high;
                line-name = "cam0_powdn";
        };
};

&i2c52 {
    status = "okay";
    clock-frequency = <400000>;
    #address-cells = <1>;
    #size-cells = <0>;
};

&csi0 {
    status = "okay";
};

&axi_vdma0 {
    status = "okay";
};

&mipi_dphy_rx0 {
    status = "okay";
};

&v4l2video0 {
    status = "okay";
};

&v4l2vdma0 {
    status = "okay";
};

&csi00in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <424000000>;
    remote-endpoint = <&cam00out>;
    clock-continuous;
};

&i2cmux0p0 {
        og05c10p0: og05c10@36 {
                compatible = "OV,og05c10";
                reg = <0x36>;

                clocks = <&og05c10_clk_2>;
                clock-names = "xclk";

                VANA-supply = <&og05c10_vana_2>;
                VDIG-supply = <&og05c10_vdig_2>;
                VDDL-supply = <&og05c10_vddl_2>;

                port@1 {
                        cam00out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                link-frequencies = /bits/ 64 <424000000>;
                                remote-endpoint = <&csi00in>;
                                clock-continuous;
                        };
                };
        };
};
