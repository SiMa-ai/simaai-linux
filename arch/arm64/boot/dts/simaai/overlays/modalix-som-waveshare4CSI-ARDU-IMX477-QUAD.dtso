/dts-v1/;
/plugin/;

#include "modalix-som-waveshare4CSI-common.dtsi"


&{/} {
        xclk_0: xclk_0 {
                status = "okay";
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency = <24000000>;
        };
        xclk_1: xclk_1 {
                status = "okay";
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency = <24000000>;
        };
        xclk_2: xclk_2 {
                status = "okay";
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency = <24000000>;
        };
        xclk_3: xclk_3 {
                status = "okay";
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency = <24000000>;
        };
};

&port5 {
    cam-hog0 {
        gpio-hog;
        /* Set port5 gpio6 to GPIO_ACTIVE_HIGH mode */
        gpios = <6 0>;
        output-high;
        line-name = "cam0_powdn";
    };
};

&csi0 {
    status = "okay";
};

&axi_vdma0 {
    status = "okay";
};

&mipi_dphy_rx0 {
    status = "okay";
};

&v4l2video0 {
    status = "okay";
};

&v4l2vdma0 {
    status = "okay";
};

&port5 {
    cam-hog1 {
        gpio-hog;
        /* Set port5 gpio7 to GPIO_ACTIVE_HIGH mode */
        gpios = <7 0>;
        output-high;
        line-name = "cam1_powdn";
    };
};

&csi1 {
    status = "okay";
};

&axi_vdma1 {
    status = "okay";
};

&mipi_dphy_rx1 {
    status = "okay";
};

&v4l2video1 {
    status = "okay";
};

&v4l2vdma1 {
    status = "okay";
};

&port6 {
    cam-hog2 {
        gpio-hog;
        /* Set port6 gpio7 to GPIO_ACTIVE_HIGH mode */
        gpios = <7 0>;
        output-high;
        line-name = "cam2_powdn";
    };
};

&csi2 {
    status = "okay";
};

&axi_vdma2 {
    status = "okay";
};

&mipi_dphy_rx2 {
    status = "okay";
};

&v4l2video2 {
    status = "okay";
};

&v4l2vdma2 {
    status = "okay";
};

&port7 {
    cam-hog3 {
        gpio-hog;
        /* Set port7 gpio4 to GPIO_ACTIVE_HIGH mode */
        gpios = <4 0>;
        output-high;
        line-name = "cam3_powdn";
    };
};

&csi3 {
    status = "okay";
};

&axi_vdma3 {
    status = "okay";
};

&mipi_dphy_rx3 {
    status = "okay";
};

&v4l2video3 {
    status = "okay";
};

&v4l2vdma3 {
    status = "okay";
};





&csi00in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <450000000>;
    remote-endpoint = <&cam00out>;
    clock-continuous;
};

&csi10in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <450000000>;
    remote-endpoint = <&cam10out>;
    clock-continuous;
};

&csi20in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <450000000>;
    remote-endpoint = <&cam20out>;
    clock-continuous;
};

&csi30in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <450000000>;
    remote-endpoint = <&cam30out>;
    clock-continuous;
};

&i2c0 {
        imx477s0: imx477@1a {
                compatible = "sony,imx477";
                reg = <0x1a>;

                clocks = <&xclk_0>;
                clock-names = "xclk";

                port@1 {
                        cam00out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                link-frequencies = /bits/ 64 <450000000>;
                                remote-endpoint = <&csi00in>;
                                clock-continuous;
                        };
                };
        };
};

&i2c1 {
        imx477s1: imx477@1a {
                compatible = "sony,imx477";
                reg = <0x1a>;

                clocks = <&xclk_1>;
                clock-names = "xclk";

                port@1 {
                        cam10out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                link-frequencies = /bits/ 64 <450000000>;
                                remote-endpoint = <&csi10in>;
                                clock-continuous;
                        };
                };
        };
};

&i2c2 {
        imx477s2: imx477@1a {
                compatible = "sony,imx477";
                reg = <0x1a>;

                clocks = <&xclk_2>;
                clock-names = "xclk";

                port@1 {
                        cam20out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                link-frequencies = /bits/ 64 <450000000>;
                                remote-endpoint = <&csi20in>;
                                clock-continuous;
                        };
                };
        };
};

&i2c3 {
        imx477s3: imx477@1a {
                compatible = "sony,imx477";
                reg = <0x1a>;

                clocks = <&xclk_3>;
                clock-names = "xclk";

                port@1 {
                        cam30out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                link-frequencies = /bits/ 64 <450000000>;
                                remote-endpoint = <&csi30in>;
                                clock-continuous;
                        };
                };
        };
};