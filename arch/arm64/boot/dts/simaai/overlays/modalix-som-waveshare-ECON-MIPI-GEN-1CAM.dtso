/dts-v1/;
/plugin/;

&{/} {

    i2cmux0: i2cmux@0 {
        compatible = "i2c-mux-gpio";
        i2c-parent = <&i2c52>;
        #address-cells = <1>;
        #size-cells = <0>;
        /* Set port6 gpio6 to GPIO_ACTIVE_LOW mode */
        mux-gpios = <&port6 6 0>;
        i2cmux0p0: i2c@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;
        };
    };
};

&port5 {
    cam-hog0 {
        gpio-hog;
        /* Set port5 gpio6 to GPIO_ACTIVE_HIGH mode */
        gpios = <6 0>;
        output-high;
        line-name = "cam0_powdn";
    };
};

&i2c52 {
    status = "okay";
    clock-frequency = <400000>;
    #address-cells = <1>;
    #size-cells = <0>;
};

&csi1 {
    status = "okay";
};

&axi_vdma1 {
    status = "okay";
};

&mipi_dphy_rx1 {
    status = "okay";
};

&v4l2video1 {
    status = "okay";
};

&v4l2vdma1 {
    status = "okay";
};

&csi10in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <594000000>;
    remote-endpoint = <&cam10out>;
    clock-continuous;
};

&i2cmux0p0 {

	pca6408_fpga: pca6408@0x21 {
        compatible = "ti,tca6408";                              
        gpio-controller;                                        
        #gpio-cells = <2>;                                      
        reg = <0x21>;                                           
        status = "okay";                                        
    };

	pca6408_econ_mipigen: pca6408@0x20 {
		compatible = "ti,tca6408";
		gpio-controller;
		#gpio-cells = <2>;
		reg = <0x20>;
		status = "okay";
		pca6408_mipi_gen_1_outlow {
			gpio-hog;
			gpios = <0 0 1 0 5 0 6 0>;
			output-low;
			label = "pca6408_mipi_gen_1_outlow_0",
					"pca6408_mipi_gen_1_outlow_1",
					"pca6408_mipi_gen_1_outlow_5",
					"pca6408_mipi_gen_1_outlow_6";
		};
	};

    fpga: fpga@c {
		compatible = "econ,fpga";
		reg = <0x0c>;
		status = "okay";
		fpga_nprogram-gpios = <&pca6408_fpga 2 0>;
        fpga_nreset-gpios = <&pca6408_fpga 3 0>;
        fpga_slaveid_sel0-gpios = <&pca6408_fpga 4 0>;
        fpga_slaveid_sel1-gpios = <&pca6408_fpga 7 0>;
		mipi_filter_dt1 = <0x92>;
		mipi_filter_dt2 = <0x93>;
		mipi_filter_dt3 = <0xb7>;
		mipi_filter_dt4 = <0x7f>;
		mipi_speed = <1188>;
		mipi_tx_clockmode = <0>; // Discontinuous
		mipi_rx_clockmode = <0>; // Discontinuous
	};

    econ_mipigen: econ_mipigen@d {
 		compatible = "econ,mipi_gen";
		reg = <0x0d>;
		fpga_nprogram-gpios = <&pca6408_econ_mipigen 2 0>;
		fpga_nreset-gpios = <&pca6408_econ_mipigen 3 0>;
		fpga_slaveid_sel0-gpios = <&pca6408_econ_mipigen 4 0>;
		fpga_slaveid_sel1-gpios = <&pca6408_econ_mipigen 7 0>;
		mipi_speed = <1188>;
		mipi_tx_clockmode = <0>; // Discontinuous

        port@1 {
            cam10out: endpoint@0 {
                clock-lanes = <0>;
                data-lanes = <1 2>;
                link-frequencies = /bits/ 64 <594000000>;
                remote-endpoint = <&csi10in>;
                clock-continuous;
            };
        };
    };
};
