/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h> 

&{/} {
        xclk_shared: xclk {
                status = "okay";
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency = <24000000>;
        };

        i2cmux0: i2cmux@0 {
                compatible = "i2c-mux-gpio";
                i2c-parent = <&i2c52>;
                #address-cells = <1>;
                #size-cells = <0>;
                /* Set port6 gpio6 to GPIO_ACTIVE_LOW mode */
                mux-gpios = <&port6 6 0>;

                i2cmux0p0: i2c@0 {
                    reg = <0>;
                    #address-cells = <1>;
                    #size-cells = <0>;
                };

                i2cmux0p1: i2c@1 {
                    reg = <1>;
                    #address-cells = <1>;
                    #size-cells = <0>;
                };
        };
};

&port5 {
    
        gpio-line-names =
                     "",        /* pin 0 */
                     "",        /* pin 1 */
                     "",        /* pin 2 */
                     "",        /* pin 3 */
                     "",        /* pin 4 */
                     "",        /* pin 5 */
                     "SIMOR_RESET";        /* pin 6 */

        cam-hog1 {
                gpio-hog;
                /* Set port5 gpio7 to GPIO_ACTIVE_HIGH mode */
                gpios = <7 0>;
                output-high;
                line-name = "EEPROM_WP";
        };
};

&i2c52 {
    status = "okay";
    clock-frequency = <400000>;
    #address-cells = <1>;
    #size-cells = <0>;
};

&csi1 {
    status = "okay";
};

&csi2 {
    status = "okay";
};

&axi_vdma1 {
    status = "okay";
};

&axi_vdma2 {
    status = "okay";
};

&mipi_dphy_rx1 {
    status = "okay";
};

&mipi_dphy_rx2 {
    status = "okay";
};

&v4l2video1 {
    status = "okay";
};

&v4l2video2 {
    status = "okay";
};

&v4l2vdma1 {
    status = "okay";
};

&v4l2vdma2 {
    status = "okay";
};

&csi10in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <450000000>;
    remote-endpoint = <&cam10out>;
    clock-continuous;
};

&csi20in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <450000000>;
    remote-endpoint = <&cam20out>;
    clock-continuous;
};

&i2cmux0p0 {
         xc9080: xc9080@1b {
                 compatible = "Metoak,xc9080";
                 reg = <0x1b>;
                 
                 startup-delay-ms = <0>;
                 reset-gpios = <&port5 6 GPIO_ACTIVE_LOW>;   

                port@1 {
                        cam10out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                link-frequencies = /bits/ 64 <480000000>;
                                remote-endpoint = <&csi10in>;
                                clock-continuous;
                        };
                };
        };

        simor: simor@66 {
                compatible = "Metoak,simor";
                reg = <0x66>;
                
		port@1 {
                        cam20out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                link-frequencies = /bits/ 64 <480000000>;
                                remote-endpoint = <&csi20in>;
                                clock-continuous;
                        };
                };
      };

};
