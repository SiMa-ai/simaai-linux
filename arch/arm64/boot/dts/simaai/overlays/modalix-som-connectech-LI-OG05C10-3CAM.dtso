/dts-v1/;
/plugin/;

#include "modalix-som-connectech-3CAM.dtsi"

&{/} {
    og05c10_vana_3: csi3_fixedregulator@0 {
        compatible = "regulator-fixed";
        regulator-name = "og05c10_vana_3";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
        enable-active-high;
        startup-delay-us = <300000>;
        regulator-always-on;
    };

    og05c10_vdig_3: csi3_fixedregulator@1 {
        compatible = "regulator-fixed";
        regulator-name = "og05c10_vdig_3";
        regulator-min-microvolt = <1050000>;
        regulator-max-microvolt = <1050000>;
        regulator-always-on;
    };

    og05c10_vddl_3: csi3_fixedregulator@2 {
        compatible = "regulator-fixed";
        regulator-name = "og05c10_vddl_3";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
    };

    og05c10_clk_3: csi3_camera-clk {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <27000000>;
    };
};

&csi30in {
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <424000000>;
    remote-endpoint = <&cam30out>;
    clock-continuous;
};

&i2c3 {
        og05c10s3: og05c10@36 {
                compatible = "OV,og05c10";
                reg = <0x36>;

                clocks = <&og05c10_clk_3>;
                clock-names = "xclk";

                VANA-supply = <&og05c10_vana_3>;
                VDIG-supply = <&og05c10_vdig_3>;
                VDDL-supply = <&og05c10_vddl_3>;

                port@1 {
                        cam30out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                link-frequencies = /bits/ 64 <424000000>;
                                remote-endpoint = <&csi30in>;
                                clock-continuous;
                        };
                };
        };
};
