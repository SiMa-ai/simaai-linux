// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Copyright (c) 2026 SiMa ai
 *
 * Second camera on the shared MAX96716A deserializer (GMSL link B,
 * Pipe Z) - companion to modalix-hhhlv2-linkA-ECON-GMSL-IMX568-3CAM.dtso.
 * Both overlays wire to the same physical csi3 controller, but to
 * VC1's sink port (csi31in) instead of VC0's (csi30in), matching Pipe
 * Z's VC1 remap in the deserializer config.
 *
 * reg = <0x43> is the address this camera's MCU answers on from the
 * SoC's side. Both modules are identical and natively answer at 0x42;
 * SER2_I2C_CONF (econ_imx568_serdes.h) programs the MAX9295A's
 * downstream-device translator with SRC_B=0x43 -> DST_B=0x42, so the
 * module keeps 0x42 on its own local bus and does not collide with
 * linkA's imx568@42 when both overlays load together.
 *
 * csi3/axi_vdma3/mipi_dphy_rx3/v4l2video3/v4l2vdma3 status=okay is
 * repeated here even though linkA's overlay already enables them -
 * harmless when both load together (idempotent), and kept so this
 * overlay is self-sufficient if ever tested alone.
 */

/dts-v1/;
/plugin/;

&{/} {
    imx568_clk1: imx568_clk1 {
        status = "okay";
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <37125000>;
    };

    imx568_vana1: vana1 {
        compatible = "regulator-fixed";
        regulator-name = "imx568_vana1";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        enable-active-high;
        startup-delay-us = <300000>;
        regulator-always-on;
    };

    imx568_vdig1: vdig1 {
        compatible = "regulator-fixed";
        regulator-name = "imx568_vdig1";
        regulator-min-microvolt = <110000>;
        regulator-max-microvolt = <110000>;
        regulator-always-on;
    };

    imx568_vddl1: vddl1 {
        compatible = "regulator-fixed";
        regulator-name = "vddl1";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
    };
};

&csi3 {
    status = "okay";
};

&axi_vdma3 {
    status = "okay";
};

&mipi_dphy_rx3 {
    status = "okay";
};

&v4l2video3 {
    status = "okay";
};

&v4l2vdma3 {
    status = "okay";
};

/* VC1's video capture node. Disabled by default in modalix-mipi.dtsi
 * (only VC0's raw30in is enabled there), so it must be turned on
 * explicitly or the VC1 stream has nowhere to land. */
&raw31in {
    status = "okay";
};

/* VC1's sink port on csi3 - port@2/reg=2, same VC-numbering convention
 * as csi2's csi20in/csi21in/csi22in/csi23in. Must match both the VC the
 * deserializer stamps (DSER_PIPE_Z_CONF's MAP_DST_* bytes) and the
 * sima,virtual-channel property on the camera endpoint below. */
&csi31in{
    clock-lanes = <0>;
    data-lanes = <1 2 3 4>;
    link-frequencies = /bits/ 64 <594000000>;
    remote-endpoint = <&cam31out>;
    clock-continuous;
};

&i2c01 {
    status = "okay";
    clock-frequency = <400000>;
    #address-cells = <1>;
    #size-cells = <0>;

    imx568b: imx568@43 {
        compatible = "econ,imx568-gmsl";
        /* translated address - see file header */
        reg = <0x43>;
        clocks = <&imx568_clk1>;
        clock-names = "xclk";
        VANA-supply = <&imx568_vana1>;
        VDIG-supply = <&imx568_vdig1>;
        VDDL-supply = <&imx568_vddl1>;
        camera_mipi_lanes = <2>;
        cam_fw_name = "imx568_cam_fw_gmsl.bin";
        port@1 {
            reg = <1>;
            cam31out: endpoint@0 {
                reg = <0>;
                clock-lanes = <0>;
                data-lanes = <1 2 3 4>;
                link-frequencies = /bits/ 64 <594000000>;
                remote-endpoint = <&csi31in>;
                clock-continuous;
                /*
                 * VC the deserializer stamps on this camera's packets
                 * (DSER_PIPE_Z_CONF MAP_DST_*). The driver reports it
                 * via .get_frame_desc and dwc-mipi-csi2 programs the
                 * IPI VCID filter from it.
                 */
                sima,virtual-channel = <1>;
            };
        };
    };
};
