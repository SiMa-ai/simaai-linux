/dts-v1/;
/plugin/;

&{/} {
    ar0234_vana_3: csi3_fixedregulator@0 {
        compatible = "regulator-fixed";
        regulator-name = "ar0234_vana_3";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
        enable-active-high;
        startup-delay-us = <300000>;
        regulator-always-on;
    };
    ar0234_vdig_3: csi3_fixedregulator@1 {
        compatible = "regulator-fixed";
        regulator-name = "ar0234_vdig_3";
        regulator-min-microvolt = <1050000>;
        regulator-max-microvolt = <1050000>;
        regulator-always-on;
    };
    ar0234_vddl_3: csi3_fixedregulator@2 {
        compatible = "regulator-fixed";
        regulator-name = "ar0234_vddl_3";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
    };
    ar0234_clk_3: csi3_camera-clk {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <27000000>;
    };
};

&csi3 {
    status = "okay";
};

&axi_vdma3 {
    status = "okay";
};

&mipi_dphy_rx3 {
    status = "okay";
};

&v4l2video3 {
    status = "okay";
};

&v4l2vdma3 {
    status = "okay";
};

&csi30in{
    clock-lanes = <0>;
    data-lanes = <1 2>;
    link-frequencies = /bits/ 64 <270000000>;
    remote-endpoint = <&cam30out>;
    clock-continuous;
};

&i2c03 {
        status = "okay";
        clock-frequency = <400000>;
        #address-cells = <1>;
        #size-cells = <0>;

        ar0234: ar0234@10 {
                compatible = "onsemi,ar0234";
                reg = <0x10>;

                clocks = <&ar0234_clk_3>;
                clock-names = "xclk";

                VANA-supply = <&ar0234_vana_3>;
                VDIG-supply = <&ar0234_vdig_3>;
                VDDL-supply = <&ar0234_vddl_3>;

                port@1 {
                        cam30out: endpoint@0 {
                                clock-lanes = <0>;
                                data-lanes = <1 2>;
                                link-frequencies = /bits/ 64 <270000000>;
                                remote-endpoint = <&csi30in>;
                                clock-continuous;
                        };
                };
        };
};
