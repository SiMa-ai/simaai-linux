/dts-v1/;

#include "modalix.dtsi"

/ {
	model = "SiMa.ai Modalix Kontron Board";

	chosen {
		bootargs = "console=ttyS0,115200n8 root=/dev/ram0 rw rootfstype=ramfs uio_pdrv_genirq.of_id=generic-uio";
		linux,initrd-start = <0x10 0x7D000000>;
		linux,initrd-end = <0x10 0x7E400000>;
	};

	aliases {
		console = &uart12;
		mmc0 = &nvs_sdhci0;
		mmc1 = &nvs_sdhci1;
		rtc0 = &pcf85063;
	};

	memory@1000000000 {
		device_type = "memory";
		reg = < 0x00000010 0x00000000 0x00000000 0x6FC00000
				0x00000010 0x75000000 0x00000002 0x8B000000>;
	};

	thermal-zones {
		board {
			polling-delay = <30000>;
			polling-delay-passive = <5000>;
			thermal-sensors = <&board_edge_sensor>;

			trips {
				board_alert: board-alert {
					temperature = <85000>;
					hysteresis = <3000>;
					type = "active";
				};
				board_crit: board-crit {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&board_alert>;
				};
				map1 {
					trip = <&board_crit>;
				};
			};
		};
	};

	reg12v0: fixedregulator-12v {
		compatible = "regulator-fixed";
		regulator-name = "in_supply";
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		regulator-always-on;
	};

	reg3v3: fixedregulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_supply";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&dms0_reserved {
	reg = <0x00000013 0x00000000 0x00000004 0x00000000>;
};

&nvs_sdhci0 {
	status = "okay";
};

&nvs_sdhci1 {
	max-frequency = <25000000>;
	status = "okay";
};

&sio0 {
	status = "okay";
};

&sio1 {
	status = "okay";
};

&sio2 {
	status = "okay";
};

&sio3 {
	status = "okay";
};

&sio4 {
	status = "okay";
};

&sio6 {
	status = "okay";
};

&sio7 {
	status = "okay";
};

&gpio30 {
	pinctrl-0 = <&pins_gpio33_deafult>;
	pinctrl-names = "default";
	status = "okay";
};

&gpio60 {
	pinctrl-0 = <&pins_gpio60_deafult>, <&pins_gpio61_deafult>,
		    <&pins_gpio62_deafult>, <&pins_gpio63_deafult>,
		    <&pins_gpio64_deafult>, <&pins_gpio65_deafult>;
	pinctrl-names = "default";
	status = "okay";
};

&gpio70 {
	pinctrl-0 = <&pins_gpio77_deafult>;
	pinctrl-names = "default";
	status = "okay";
};

&xgmac0 {
        phy-mode = "sgmii";
        managed = "in-band-status";
        snps,ps-speed = <1000>;
        phy-handle = <&ethernet_phy0>;
        status = "okay";
        mdio0 {
                compatible = "snps,dwmac-mdio";
                #address-cells = <1>;
                #size-cells = <0>;

                ethernet_phy0: ethernet-phy@0 {
                        reg = <0>;
                };
        };
};
&xgmac1 {
        phy-mode = "sgmii";
        managed = "in-band-status";
        snps,ps-speed = <1000>;
        phy-handle = <&ethernet_phy1>;
        status = "okay";
        mdio1 {
                compatible = "snps,dwmac-mdio";
                #address-cells = <1>;
                #size-cells = <0>;

                ethernet_phy1: ethernet-phy@0 {
                        reg = <0>;
                };
        };
};
&xgmac2 {
        phy-mode = "sgmii";
        managed = "in-band-status";
        snps,ps-speed = <1000>;
        phy-handle = <&ethernet_phy2>;
        status = "okay";
        mdio2 {
                compatible = "snps,dwmac-mdio";
                #address-cells = <1>;
                #size-cells = <0>;

                ethernet_phy2: ethernet-phy@0 {
                        reg = <0>;
                };
        };
};
&xgmac3 {
        phy-mode = "sgmii";
        managed = "in-band-status";
        snps,ps-speed = <1000>;
        phy-handle = <&ethernet_phy3>;
        status = "okay";
        mdio3 {
                compatible = "snps,dwmac-mdio";
                #address-cells = <1>;
                #size-cells = <0>;

                ethernet_phy3: ethernet-phy@0 {
                        reg = <0>;
                };
        };
};

&i2c00 {
	status = "okay";
	clock-frequency = <400000>;

	board_edge_sensor: temp-sensor@48 {
		compatible = "ti,tmp101";
		reg = <0x48>;
		#thermal-sensor-cells = <0>;
	};

	eeprom@50 {
		compatible = "atmel,24c128";
		reg = <0x50>;
		pagesize = <64>;
		num-addresses = <1>;
	};

	pcf85063: rtc@51 {
		compatible = "nxp,pcf85063a";
		reg = <0x51>;
	};

};

&i2c43 {
	status = "okay";
	clock-frequency = <400000>;

	spi@28 {
		compatible = "nxp,sc18is606";
		reg = <0x28>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&uart12 {
	status = "okay";
};

&pcie0_ep {
	status = "okay";
};
