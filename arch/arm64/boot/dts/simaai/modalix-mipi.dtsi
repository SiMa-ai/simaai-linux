			#address-cells = <1>;
			#size-cells = <0>;
			raw03in: endpoint@0 {
				reg = <0>;
				status = "disabled";
				label = "raw-capture.0.3";
				remote-endpoint = <&vdma03out>;
			};
		};
	};

