			};
		};
	};

	v4l2vdma0: vdma@0 {
		compatible = "simaai,v4l2-vdma";
		id = <0x0>;
		dmas = <&axi_vdma0 0>, <&axi_vdma0 1>, <&axi_vdma0 2>, <&axi_vdma0 3>;
		dma-names = "channel-0", "channel-1", "channel-2", "channel-3";
		status = "disabled";

		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			vdma00in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&csi00out>;
			};
			vdma00out: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&raw00in>;
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			vdma01in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&csi01out>;
			};
			vdma01out: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&raw01in>;
			};
		};
		port@2 {
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;
			vdma02in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&csi02out>;
			};
			vdma02out: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&raw02in>;
			};
		};
		port@3 {
			reg = <3>;
			#address-cells = <1>;
			#size-cells = <0>;
			vdma03in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&csi03out>;
			};
			vdma03out: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&raw03in>;
			};
		};
	};

	v4l2vdma1: vdma@1 {
		compatible = "simaai,v4l2-vdma";
		id = <0x1>;
		dmas = <&axi_vdma1 0>, <&axi_vdma1 1>, <&axi_vdma1 2>, <&axi_vdma1 3>;
		dma-names = "channel-0", "channel-1", "channel-2", "channel-3";
		status = "disabled";

		#address-cells = <1>;
