	v4l2video0: csi2video@0 {
		compatible = "simaai,v4l2-video";
		status = "disabled";

		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			raw00in: endpoint@0 {
				reg = <0>;
				label = "raw-capture.0.0";
				remote-endpoint = <&vdma00out>;
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			raw01in: endpoint@0 {
				reg = <0>;
				status = "disabled";
				label = "raw-capture.0.1";
				remote-endpoint = <&vdma01out>;
			};
		};
		port@2 {
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;
			raw02in: endpoint@0 {
				reg = <0>;
				status = "disabled";
				label = "raw-capture.0.2";
				remote-endpoint = <&vdma02out>;
			};
		};
		port@3 {
